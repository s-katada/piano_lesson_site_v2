---
import { Check, Sprout, TreeDeciduous } from "lucide-astro";

const pricingPlans = [
  {
    title: "ベーシックコース",
    description: "初心者・小学生の方向け",
    price: "¥4,000",
    features: ["月4回レッスン（1回30分）", "基礎から丁寧に指導", "簡単な曲を演奏できるように指導"],
    Icon: Sprout,
    chipClass: "bg-forest/10 text-forest",
  },
  {
    title: "アドバンスコース",
    description: "本格的に学びたい小学生から大人の方向け",
    price: "¥5,000",
    features: [
      "月4回レッスン（1回50分）",
      "個人のペースに合わせた指導",
      "お好きな曲を演奏できるように指導",
    ],
    Icon: TreeDeciduous,
    chipClass: "bg-accent text-primary",
  },
];
---

<section
  class="bg-gradient-to-b from-accent/50 via-background to-background pb-20 pt-32 sm:pb-24 sm:pt-36"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="font-display text-xs font-bold uppercase tracking-[0.3em] text-primary sm:text-sm">
        Pricing
      </p>
      <h1 class="mt-3 font-display text-3xl font-bold sm:text-4xl">料金プラン</h1>
      <p class="mx-auto mt-5 max-w-2xl leading-7 text-balance text-muted-foreground">
        <span class="inline-block">お子様から大人まで、</span><span class="inline-block"
          >目的に合わせて選べる</span
        ><span class="inline-block">2つのコース</span>
      </p>
    </div>

    <div class="mx-auto mt-14 grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2 md:gap-8">
      {
        pricingPlans.map((plan) => (
          <div class="flex flex-col rounded-3xl border border-border/70 bg-card p-8 shadow-[0_8px_30px_rgb(63_54_46/0.05)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_16px_40px_rgb(63_54_46/0.1)] sm:p-9">
            <div class="flex items-center gap-4">
              <div
                class={`flex h-13 w-13 shrink-0 items-center justify-center rounded-2xl ${plan.chipClass}`}
              >
                <plan.Icon class="h-6 w-6" />
              </div>
              <div>
                <h2 class="font-display text-xl font-bold">{plan.title}</h2>
                <p class="mt-1 text-sm text-muted-foreground">{plan.description}</p>
              </div>
            </div>

            <div class="mt-7 flex items-baseline gap-1.5">
              <span class="font-display text-4xl font-bold tracking-tight">{plan.price}</span>
              <span class="text-muted-foreground">/月</span>
            </div>

            <ul class="mt-7 flex-grow space-y-3.5 border-t border-border/70 pt-7">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-forest/12 text-forest">
                    <Check class="h-3 w-3" />
                  </span>
                  <span class="text-sm leading-6 text-foreground/80">{feature}</span>
                </li>
              ))}
            </ul>

            <a
              href="/contact?type=lesson"
              class="mt-9 block w-full rounded-full bg-primary px-6 py-3.5 text-center text-sm font-bold text-primary-foreground shadow-sm transition-all hover:-translate-y-0.5 hover:bg-primary/90 hover:shadow-md sm:text-base"
            >
              このコースで始める
            </a>
          </div>
        ))
      }
    </div>

    <p class="mt-12 text-center text-sm leading-6 text-muted-foreground">
      ※ 教材費は別途実費となるケースがあります
    </p>
  </div>
</section>
