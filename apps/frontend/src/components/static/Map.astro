---
import { MapPin } from "lucide-astro";

const mapEmbedUrl =
  "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3251.8!2d137.4!3d35.4!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2s岐阜県中津川市福岡510-32!5e0!3m2!1sja!2sjp!4v1";
const mapDirectionsUrl = "https://www.google.com/maps/dir//岐阜県中津川市福岡510-32";
---

<section id="access" class="bg-card py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="font-display text-xs font-bold uppercase tracking-[0.3em] text-primary sm:text-sm">
        Access
      </p>
      <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">アクセス</h2>
      <p class="mt-5 inline-flex items-center gap-2 text-muted-foreground">
        <MapPin class="h-4 w-4 shrink-0 text-primary" />
        〒508-0203 岐阜県中津川市福岡510-32
      </p>
    </div>

    <div class="mt-12 flex flex-col items-center gap-9">
      <div class="w-full max-w-4xl">
        <div
          class="h-[400px] w-full overflow-hidden rounded-3xl border border-border shadow-[0_16px_44px_rgb(63_54_46/0.1)]"
        >
          <iframe
            src={mapEmbedUrl}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="どんぐりピアノ教室の地図"></iframe>
        </div>
      </div>
      <a
        href={mapDirectionsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-primary/35 bg-transparent px-7 py-3 text-sm font-bold text-primary transition-colors hover:bg-primary hover:text-primary-foreground sm:text-base"
      >
        <MapPin class="h-4 w-4" />
        Google Mapで経路を見る
      </a>
    </div>
  </div>
</section>
