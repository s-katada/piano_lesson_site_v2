---
import { BookOpen, Clock, Music } from "lucide-astro";

const features = [
  {
    title: "個人のペースに合わせたレッスン",
    description: "初心者から上級者まで、一人ひとりの目標とペースに合わせて指導します",
    Icon: BookOpen,
    chipClass: "bg-accent text-primary",
  },
  {
    title: "柔軟なスケジュール",
    description: "お仕事や学校のご都合に合わせて、レッスン時間を調整いたします",
    Icon: Clock,
    chipClass: "bg-forest/10 text-forest",
  },
  {
    title: "幅広いジャンル",
    description: "クラシックからポップスまで、お好きな曲を楽しく学べます",
    Icon: Music,
    chipClass: "bg-accent text-primary",
  },
];
---

<section id="features" class="bg-background py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="font-display text-xs font-bold uppercase tracking-[0.3em] text-primary sm:text-sm">
        Features
      </p>
      <h2 class="mt-3 font-display text-3xl font-bold text-balance sm:text-4xl">
        <span class="inline-block">どんぐり</span><span class="inline-block">ピアノ教室の特徴</span>
      </h2>
      <p class="mx-auto mt-5 max-w-2xl leading-7 text-balance text-muted-foreground">
        <span class="inline-block">一人ひとりが</span><span class="inline-block">音楽を</span><span
          class="inline-block">楽しめるように、</span
        ><span class="inline-block">3つのことを</span><span class="inline-block"
          >大切にしています</span
        >
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        features.map((feature) => (
          <div class="group rounded-3xl border border-border/70 bg-card p-8 text-center shadow-[0_8px_30px_rgb(63_54_46/0.05)] transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_16px_40px_rgb(63_54_46/0.1)]">
            <div
              class={`mx-auto flex h-16 w-16 items-center justify-center rounded-2xl ${feature.chipClass} transition-transform duration-300 group-hover:scale-110`}
            >
              <feature.Icon class="h-7 w-7" />
            </div>
            <h3 class="mt-6 font-display text-lg font-bold">{feature.title}</h3>
            <p class="mt-3 text-sm leading-7 text-muted-foreground">{feature.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
