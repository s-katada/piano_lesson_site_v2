---
import { Menu, X } from "lucide-astro";
import AcornMark from "./AcornMark.astro";
import "../../styles/header.css";

export interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const navigation = [
  { name: "ホーム", href: "/" },
  { name: "料金", href: "/pricing" },
  { name: "講師紹介", href: "/instructor" },
  { name: "お問い合わせ", href: "/contact" },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  data-overlay={overlay ? "true" : undefined}
  class="fixed inset-x-0 top-0 z-50"
>
  <nav class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between sm:h-18">
      <a href="/" class="group flex items-center gap-2.5">
        <AcornMark
          class="h-8 w-8 text-(--header-accent) transition-[color,transform] duration-300 group-hover:-rotate-6"
        />
        <span
          class="font-display text-lg font-bold tracking-wide text-(--header-ink) transition-colors duration-300"
        >
          どんぐりピアノ教室
        </span>
      </a>

      <div class="hidden items-center gap-1 md:flex">
        {
          navigation.map((item) => (
            <a
              href={item.href}
              data-active={currentPath === item.href ? "true" : undefined}
              class="nav-link relative px-3.5 py-2 text-sm font-medium transition-colors"
            >
              {item.name}
            </a>
          ))
        }
        <a
          href="/contact?type=trial"
          class="header-cta ml-3 inline-flex items-center rounded-full px-5 py-2.5 text-sm font-bold"
        >
          無料体験レッスン
        </a>
      </div>

      <input type="checkbox" id="mobile-menu-toggle" class="hidden" />
      <label for="mobile-menu-toggle" class="-mr-2 cursor-pointer p-2 md:hidden">
        <span class="sr-only">メニューを開閉する</span>
        <div class="menu-icon">
          <Menu class="h-6 w-6 text-(--header-ink)" />
        </div>
        <div class="close-icon hidden">
          <X class="h-6 w-6 text-(--header-ink)" />
        </div>
      </label>

      <div
        id="mobile-menu"
        class="absolute inset-x-0 top-full hidden border-b border-border bg-background/95 shadow-lg backdrop-blur-xl md:hidden"
      >
        <div class="space-y-1 px-4 pb-6 pt-3">
          {
            navigation.map((item) => (
              <a
                href={item.href}
                class={`block rounded-xl px-4 py-3 text-base font-medium transition-colors ${
                  currentPath === item.href
                    ? "bg-accent text-primary"
                    : "text-foreground/75 hover:bg-secondary hover:text-foreground"
                }`}
              >
                {item.name}
              </a>
            ))
          }
          <a
            href="/contact?type=trial"
            class="mt-3 block rounded-full bg-primary px-5 py-3 text-center text-base font-bold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90"
          >
            無料体験レッスン
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  if (header) {
    const update = () => {
      if (window.scrollY > 24) {
        header.setAttribute("data-scrolled", "");
      } else {
        header.removeAttribute("data-scrolled");
      }
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
