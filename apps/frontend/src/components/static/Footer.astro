---
import { MapPin, Phone, Mail } from "lucide-astro";
import AcornMark from "./AcornMark.astro";

const navigation = [
  { name: "ホーム", href: "/" },
  { name: "料金", href: "/pricing" },
  { name: "講師紹介", href: "/instructor" },
  { name: "お問い合わせ", href: "/contact" },
];

const year = new Date().getFullYear();
---

<footer class="mt-auto bg-forest-deep text-cream">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-[1.3fr_0.8fr_1.2fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5">
          <AcornMark class="h-8 w-8 text-[#e8c98a]" />
          <span class="font-display text-lg font-bold tracking-wide">どんぐりピアノ教室</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-7 text-cream/65">
          岐阜県中津川市にある小さなピアノ教室です。初心者の方から経験者まで、楽しく学べるレッスンをお届けします。
        </p>
      </div>

      <nav aria-label="フッターナビゲーション">
        <h3 class="font-display text-xs font-bold uppercase tracking-[0.25em] text-cream/50">
          Menu
        </h3>
        <ul class="mt-4 space-y-2.5">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-cream/75 transition-colors hover:text-white"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h3 class="font-display text-xs font-bold uppercase tracking-[0.25em] text-cream/50">
          Contact
        </h3>
        <ul class="mt-4 space-y-3">
          <li class="flex items-start gap-2.5">
            <MapPin class="mt-0.5 h-4 w-4 shrink-0 text-[#e8c98a]" />
            <span class="text-sm leading-6 text-cream/75">〒508-0203 岐阜県中津川市福岡510-32</span>
          </li>
          <li class="flex items-center gap-2.5">
            <Phone class="h-4 w-4 shrink-0 text-[#e8c98a]" />
            <a
              href="tel:090-3934-4554"
              class="text-sm text-cream/75 transition-colors hover:text-white"
            >
              090-3934-4554
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <Mail class="h-4 w-4 shrink-0 text-[#e8c98a]" />
            <a
              href="mailto:donguri@maropu.com"
              class="text-sm text-cream/75 transition-colors hover:text-white"
            >
              donguri@maropu.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-6 text-center">
      <p class="text-xs tracking-wide text-cream/50">© {year} どんぐりピアノ教室</p>
    </div>
  </div>
</footer>
